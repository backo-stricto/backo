"""
backoffice : The main application
"""

# linter is lost with different modules with the same name
# pylint: disable=no-name-in-module


from backo import Backoffice, log_system, LogLevel

# Import all collections
{% for collection in collections %}from collections_set import {{ collection.name }}
{% endfor %}


# Set log system (for debug)
log_system.add_handler(log_system.set_streamhandler()) # output to stderr
log = log_system.get_or_create_logger("{{ name }}", LogLevel.INFO)

# -----------------------------------------
# Backoffice creation
# -----------------------------------------
my_backoffice = Backoffice("{{ name }}")
{% for collection in collections %}my_backoffice.register_collection({{ collection.name }})
{% endfor %}


# To check if you have some syntax issue
my_backoffice.check_syntax()
